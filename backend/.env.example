# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Environment Mode: 'development' or 'production'
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas database credentials.
# Note: Ensure Atlas IP Access List allows 0.0.0.0/0 (required for dynamic Render outgoing IPs).
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/aws-practice-lab?retryWrites=true&w=majority

# JWT Authentication Secret
# Generate a strong 32+ character random string for production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# Frontend Application Origin (CORS whitelist)
# In development: http://localhost:5173
# In Render production: https://your-frontend-service.onrender.com
# Multiple origins can be comma-separated: https://site1.com,https://site2.com
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173

