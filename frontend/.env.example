# Backend API Base URL
# Local development:
VITE_API_URL=http://localhost:5000/api

# Render production deployment (replace with your backend's deployed Render web service URL):
# VITE_API_URL=https://your-backend-service.onrender.com/api
# NOTE: In Vite applications, environment variables are embedded at build time.
# After updating VITE_API_URL on Render or locally, you must rebuild and redeploy the frontend.

